DATABASE_URL=postgresql://happy:happy@localhost:5433/happy_attendance?schema=public
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Múi giờ dùng để xác định "ngày làm việc", giờ đi muộn, cron
APP_TZ=Asia/Ho_Chi_Minh
# Số phút cho phép trễ trước khi tính là đi muộn
LATE_GRACE_MINUTES=10
# Hệ số độ khó của sự kiện cộng đồng (0.5 dễ — 1.0 khó)
EVENT_DIFFICULTY=0.85
# Tùy chọn: JSON service account của Firebase để gửi push qua FCM
FIREBASE_SERVICE_ACCOUNT=
