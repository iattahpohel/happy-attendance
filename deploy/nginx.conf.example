# Thêm vào server { server_name staging-internal.woka.io; ... } hiện có, rồi: nginx -t && nginx -s reload
# API: /happy-attendance/api/* -> 127.0.0.1:40000/api/*
location /happy-attendance/api/ {
    proxy_pass http://127.0.0.1:40000/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Web (Next.js giữ nguyên basePath, không strip prefix)
location /happy-attendance/ {
    proxy_pass http://127.0.0.1:30000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
